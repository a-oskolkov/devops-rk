# Ускоряем Docker build и уменьшаем контекст сборки: локальное окружение,
# кэши и VCS-данные не нужны внутри образа.
.git
.venv
__pycache__
*.py[cod]
.pytest_cache

# Тесты запускаются в CI до сборки/деплоя, а финальный runtime-образ должен
# содержать только код, нужный для работы сервиса.
app/tests
pytest.ini
